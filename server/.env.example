# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Only MONGODB_URI is required. Everything else has a working default,
# and the server prints what it is actually using when it starts.


# ----------------------------------------------------------------------
# Database. Required.
# ----------------------------------------------------------------------

# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/villa_search
#
# MongoDB Atlas, from Database, Connect, Drivers. Put the database name
# before the question mark, otherwise everything lands in the test database:
#   MONGODB_URI=mongodb+srv://user:password@cluster0.abcde.mongodb.net/villa_search?retryWrites=true&w=majority
#
# If the password has a symbol in it, percent encode it. An @ becomes %40.
MONGODB_URI=mongodb://127.0.0.1:27017/villa_search

# How long to wait for the cluster before giving up, in milliseconds.
# Atlas over a slow connection sometimes needs more than the default.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000

# Connection pool size and how many times to retry the first connection.
MONGODB_MAX_POOL_SIZE=10
MONGODB_CONNECT_RETRIES=3

# Build indexes on start. Convenient in development, switch it off on a
# production cluster and create the indexes yourself.
MONGODB_AUTO_INDEX=true


# ----------------------------------------------------------------------
# Web server
# ----------------------------------------------------------------------

# On macOS the AirPlay Receiver holds port 5000, so pick another one there.
# Whatever you set, match it in client/.env.local as VITE_API_PROXY_TARGET.
PORT=5050
HOST=0.0.0.0
NODE_ENV=development

# Which browsers may call the interface. A comma separated list of addresses,
# or * while you are developing.
#   CORS_ORIGIN=http://localhost:5173,https://villa-search.vercel.app
CORS_ORIGIN=*

# Largest accepted request body.
BODY_LIMIT=20kb

# Switch on when the server sits behind a proxy such as Render, Railway or
# Nginx, so the rate limiter sees the real visitor address.
TRUST_PROXY=false

# How long to let requests in flight finish when the process is asked to stop.
SHUTDOWN_TIMEOUT_MS=10000


# ----------------------------------------------------------------------
# Language model parsing. Optional.
# Without a key the rule parser answers every query, so the project runs
# with nothing filled in here.
# Get a free key at https://console.groq.com/keys
# ----------------------------------------------------------------------

GROQ_API_KEY=

# Set to false to force the rule parser even when a key is present.
# Useful when you want to demonstrate the fallback.
LLM_ENABLED=true

# Any endpoint that speaks the OpenAI chat completions shape works here,
# so this also points at OpenAI, Together or a local server if you want.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Tried in order. The second one is smaller and faster and only runs if the
# first one fails or times out.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

LLM_TIMEOUT_MS=5000
LLM_MAX_OUTPUT_TOKENS=500
LLM_TEMPERATURE=0


# ----------------------------------------------------------------------
# Search behaviour
# ----------------------------------------------------------------------

# Results per page, and the ceiling a client may ask for.
SEARCH_PAGE_SIZE=12
SEARCH_MAX_PAGE_SIZE=48

# How many villas are pulled from the database before scoring and paging.
SEARCH_CANDIDATE_LIMIT=240

# Longest accepted search text.
SEARCH_MAX_QUERY_LENGTH=300

# Loosen one filter at a time rather than showing an empty page.
SEARCH_RELAX_WHEN_EMPTY=true


# ----------------------------------------------------------------------
# Parse cache. Identical searches skip the model call.
# ----------------------------------------------------------------------

PARSE_CACHE_ENABLED=true
PARSE_CACHE_TTL_MS=600000
PARSE_CACHE_MAX_ENTRIES=500


# ----------------------------------------------------------------------
# Rate limit, counted per visitor address
# ----------------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60


# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------

LOG_REQUESTS=true
LOG_SLOW_REQUEST_MS=800


# ----------------------------------------------------------------------
# Seeding
# ----------------------------------------------------------------------

# How far ahead dummy bookings are generated, and the number that makes the
# seeded bookings identical every time you run the seed.
SEED_BOOKING_HORIZON_DAYS=60
SEED_RANDOM_SEED=42
