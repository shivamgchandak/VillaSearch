# Copy this file to .env.local and change what you need.
#   cp .env.example .env.local
# Vite only exposes variables that start with VITE_ to the browser, so never
# put a secret in here. The model key lives on the server and stays there.


# Where the interface sends its searches.
#
# Leave it as /api while developing. The dev server forwards that path to the
# API below, which keeps the browser on one address and avoids cross origin
# requests entirely.
#
# When the interface and the API are deployed separately, put the full address
# of the API here instead:
#   VITE_API_BASE_URL=https://villa-search-api.onrender.com/api
VITE_API_BASE_URL=/api

# Where the dev server forwards /api while you develop.
# Change it if the API runs on a different port.
VITE_API_PROXY_TARGET=http://localhost:5000

# Port for the dev server itself.
VITE_PORT=5173

# The villa team's contact, used by "Talk to us", "Chat on WhatsApp" and
# "Request a call back". Digits only for WhatsApp, with the country code.
# Left empty, WhatsApp opens with the search ready and lets the guest pick
# who to send it to, and the call back link is hidden.
VITE_TEAM_WHATSAPP=
VITE_TEAM_PHONE=
